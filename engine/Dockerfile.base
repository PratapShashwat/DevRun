# Start from the official, stable Ubuntu image
FROM ubuntu:24.04

# Prevent interactive prompts from freezing the build
ENV DEBIAN_FRONTEND=noninteractive

# 1. Install core system utilities and C++ compilers
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    nano \
    build-essential \
    software-properties-common \
    && rm -rf /var/lib/apt/lists/*

# 2. Install Python 3, pip, and venv
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# 3. Install Node.js (LTS v20) for MERN stack projects
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# 4. Install Java (JDK) - HEADLESS version to avoid UI bloat and mirror crashes
RUN apt-get update && apt-get install -y default-jdk-headless \
    && rm -rf /var/lib/apt/lists/*

# Set up the default workspace directory
WORKDIR /workspace

# Keep the container running so we can attach a terminal to it later
CMD ["/bin/bash"]